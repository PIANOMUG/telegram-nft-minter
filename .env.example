# Required
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated Telegram user IDs allowed to use the bot (leave empty for anyone)
ALLOWED_USER_IDS=

# Blockchain RPC (Alchemy recommended for speed)
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-api-key
CHAIN_ID=1
EXPLORER_URL=https://etherscan.io

# API Keys (optional but recommended)
ETHERSCAN_API_KEY=your_etherscan_api_key
OPENSEA_API_KEY=your_opensea_api_key

# Encryption key for wallet private keys (change this!)
ENCRYPTION_KEY=your-strong-encryption-password-change-me

# Database
DATABASE_PATH=data/bot.db

# Gas settings
DEFAULT_GAS_STRATEGY=fast
MAX_PRIORITY_FEE_GWEI=200
MAX_FEE_GWEI=500
GAS_LIMIT_MINT=300000

# Monitoring
MONITOR_INTERVAL_SECONDS=15
MONITOR_NEW_CONTRACTS=true

# Flashbots (optional)
FLASHBOTS_RELAY=https://relay.flashbots.net
