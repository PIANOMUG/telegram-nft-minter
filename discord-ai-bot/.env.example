# Discord Bot Token (from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# LLM API Key (OpenAI or any OpenAI-compatible API)
# For OpenAI: https://platform.openai.com/api-keys
# For Claude via OpenRouter: set base to https://openrouter.ai/api/v1
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Bot identity - tell the AI who it is and how to behave
BOT_PERSONALITY=You are a friendly, knowledgeable Discord assistant. You engage in natural conversation, help with questions, and participate meaningfully in community discussions. Keep responses concise but warm.

# Which channels to monitor (comma-separated IDs, empty = all channels)
ALLOWED_CHANNELS=

# Cooldown between messages (seconds) to avoid spam
COOLDOWN_SECONDS=2

# Max messages to remember per server (for context)
MEMORY_LIMIT=50
